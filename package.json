{
  "name": "grant-app",
  "private": true,
  "version": "0.0.0",
  "description": "Weber State CS4760 grant management monorepo root (tooling + workspaces).",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,css,json,md,html}\"",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w client",
    "seed": "npm run seed -w server",
    "lint": "npm run lint -w client",
    "test": "npm run test:run -w client && npm run test:run -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,json,md,html}": "prettier --write"
  }
}
